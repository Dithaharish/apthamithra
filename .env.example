# Database — Supabase (Postgres)
# Both values are server-side only. Deliberately NO NEXT_PUBLIC_ prefix, so
# Next.js keeps them out of the browser bundle.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# Auth — REQUIRED
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-generated-32-byte-hex-secret"
NEXTAUTH_URL="http://localhost:3000"

# Database — optional today, required for persistent accounts
# Populated once a managed Postgres (Neon / Supabase / Railway) is provisioned.
DATABASE_URL="postgresql://user:password@localhost:5432/nri_concierge"

# Payments — fill in for live mode
STRIPE_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Notifications
TWILIO_SID=""
TWILIO_TOKEN=""
WHATSAPP_API_KEY=""
RESEND_API_KEY=""

# Shipping / courier integrations
SHIPROCKET_API_KEY=""
DHL_API_KEY=""
FEDEX_API_KEY=""
